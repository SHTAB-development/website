---
import Base from '../layouts/Base.astro';
import Services from '../components/Services.astro';
import Process from '../components/Process.astro';
import Cta from '../components/Cta.astro';

const packages = [
  {
    title: 'Process audit', term: '1 week · fixed price',
    text: 'We map how your business runs today: where leads come from, where money is counted, what is done by hand. You get a plan with priorities and estimates.',
    items: ['Interviews and a walk through your tools', 'A map of the process with the bottlenecks', 'A roadmap: what to automate first and what to leave alone'],
  },
  {
    title: 'CRM launch', term: 'from 3 weeks',
    text: 'A working system on your data in the first two weeks, then the rest of the process, training and a hand-over to «runs without us».',
    items: ['Leads, customers, finances, schedule in one place', 'Automatic emails and reminders', 'A dashboard for the owner, exports for the accountant'],
  },
  {
    title: 'Automation under the key', term: 'from 2 weeks',
    text: 'A bot or an integration that takes a routine off your hands: replies to buyers, documents, reports, notifications.',
    items: ['Telegram bots and mini apps', 'LLM assistants with a tight brief', 'Stripe, marketplaces, email, calendars'],
  },
  {
    title: 'Website', term: 'from 2 weeks',
    text: 'From research and copy to launch. Fast, clean, with analytics that shows where customers come from and what they do.',
    items: ['Structure and copy first', 'Motion that serves the story', 'Deployed, measured, maintained'],
  },
];
---
<Base title="Services — SHTAB" description="Process audit, CRM launch, automation and bots, websites and native apps. Fixed scopes, clear terms, a working piece before the big decision.">
  <section class="page-hero container">
    <span class="kicker">Services</span>
    <h1 class="display">We build the system, you run the business</h1>
    <p class="lead">Four kinds of work, one rule: before you decide, you see a working piece on your own data.</p>
  </section>
  <section class="container packages" aria-label="Packages">
    {packages.map((p) => (
      <article class="package lamp reveal">
        <span class="term">{p.term}</span>
        <h3>{p.title}</h3>
        <p>{p.text}</p>
        <ul>{p.items.map((i) => <li>{i}</li>)}</ul>
      </article>
    ))}
  </section>
  <Services />
  <Process />
  <Cta title="Not sure which one you need?" text="Describe the task in two sentences. We'll suggest the smallest step that changes something." />
</Base>
