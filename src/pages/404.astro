---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found — SHTAB" description="This page doesn't exist.">
  <section class="page-hero container" style="min-height:70svh">
    <span class="kicker">404</span>
    <h1 class="display">No order here yet</h1>
    <p class="lead">The page doesn't exist or has moved. Start from the work or tell us what you were looking for.</p>
    <p style="margin-top:32px;display:flex;gap:16px;flex-wrap:wrap">
      <a class="btn btn-brass" href="/work/">See our work</a>
      <a class="btn btn-ghost" href="/">Home</a>
    </p>
  </section>
</Base>
