---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CaseCard from '../../components/CaseCard.astro';
import Cta from '../../components/Cta.astro';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Work — SHTAB" description="Ticketing for events in Scotland, a CRM that answers marketplace buyers, a school system for four branches, a private app for couples. Four systems that run without us.">
  <section class="page-hero container">
    <span class="kicker">Work</span>
    <h1 class="display">Systems that run without us</h1>
    <p class="lead">Four projects, four kinds of order: tickets and tables, buyers and replies, students and branches, a couple's shared memory.</p>
  </section>
  <section class="container" style="padding-bottom:96px">
    <div class="work-grid">
      {work.map((entry, i) => <CaseCard entry={entry} eager={i === 0} />)}
    </div>
  </section>
  <Cta title="Have a process that lives in chats and spreadsheets?" text="Tell us how it works today. We'll say what's worth automating and what isn't." />
</Base>
