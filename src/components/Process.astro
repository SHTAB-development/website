---
const steps = [
  { title: 'Conversation', text: 'We look at how your process works today and tell you honestly what\'s worth automating and what isn\'t. Free.' },
  { title: 'A working piece', text: 'Instead of slide decks we show a working part of the system on your data. Then you decide on facts, not promises.' },
  { title: 'Launch', text: 'We move the process into the system, train the team and get it to the point where it runs without us.' },
  { title: 'Support', text: 'We stay in touch: fixes, growth, new tasks. The system lives and grows with the business.' },
];
---
<section class="process container" id="process">
  <h2 class="section-title">How we work</h2>
  <ol class="steps">
    {steps.map((s, i) => (
      <li class="step reveal">
        <span class="step-num">{String(i + 1).padStart(2, '0')}</span>
        <h3>{s.title}</h3>
        <p>{s.text}</p>
      </li>
    ))}
  </ol>
</section>
