---
import Mark from './Mark.astro';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-studio">
      <a class="nav-logo" href="/" aria-label="SHTAB — back to top">
        <Mark size={26} />
        <span>SHTAB</span>
      </a>
      <p>Digital systems studio</p>
    </div>
    <nav class="footer-links" aria-label="Footer">
      <a href="/work/">Work</a>
      <a href="/services/">Services</a>
      <a href="/about/">About</a>
      <a href="/contact/">Contact</a>
      <a href="https://github.com/SHTAB-development" rel="noopener">GitHub</a>
      <a class="mono" href="mailto:shtab@shtabdev.com">shtab@shtabdev.com</a>
    </nav>
    <p class="mono">© {year}</p>
  </div>
</footer>
