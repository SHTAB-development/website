---
/* Заявка уходит в /api/lead (почта + Telegram). Если сервер недоступен — открывается готовое письмо. */
---
<form class="lead-form lamp" id="lead" novalidate data-mail="shtab@shtabdev.com">
  <div class="field">
    <label for="lead-task">What do you still do by hand?</label>
    <textarea id="lead-task" name="task" rows="4" required
      placeholder="For example: copying marketplace leads into a spreadsheet, keeping the schedule in a notebook"></textarea>
    <p class="field-error" id="lead-task-error" hidden>Describe the task in at least a few words</p>
  </div>
  <div class="field">
    <label for="lead-contact">How can we reach you</label>
    <input id="lead-contact" name="contact" type="text" required autocomplete="off" placeholder="Telegram, phone or email" />
    <p class="field-error" id="lead-contact-error" hidden>Leave a way to reach you so we can reply</p>
  </div>
  <div class="field">
    <label for="lead-name">Your name <span class="optional">— optional</span></label>
    <input id="lead-name" name="name" type="text" autocomplete="name" />
  </div>
  <input class="hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
  <button class="btn btn-brass btn-big" type="submit">Get a free review</button>
  <p class="lead-note">The conversation is free. We use your contact only to reply.</p>
  <p class="lead-status" role="status" aria-live="polite"></p>
</form>
